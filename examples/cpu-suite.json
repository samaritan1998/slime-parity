{
  "schema_version": 1,
  "name": "mlp-reference-and-dp",
  "model": {
    "adapter": "slime_parity.adapters.mlp:MLPAdapter",
    "options": {}
  },
  "reference": {
    "runner": "slime_parity.adapters.mlp:run_reference",
    "kind": "independent",
    "device": "cpu"
  },
  "candidate": {
    "runner": "slime_parity.adapters.mlp:run_candidate",
    "kind": "torch",
    "device": "cpu",
    "options": {
      "micro_batch_size": 1
    }
  },
  "training": {
    "steps": 3,
    "seed": 417,
    "global_batch_size": 4,
    "dtype": "float64",
    "optimizer": {
      "name": "adamw",
      "lr": 0.001
    }
  },
  "cases": [
    {
      "id": "ordinary"
    },
    {
      "id": "different-inputs",
      "seed_offset": 200
    }
  ],
  "matrix": {
    "world_size": [
      1,
      2
    ],
    "tp": [
      1
    ],
    "cp": [
      1
    ],
    "ep": [
      1
    ],
    "sp": [
      false
    ],
    "pp": [
      1
    ]
  },
  "policy": [
    {
      "id": "all-tensors",
      "scope": "tensor",
      "limits": {
        "atol": 1e-12,
        "rtol": 1e-10
      }
    }
  ],
  "execution": {
    "max_world_size": 2,
    "timeout_seconds": 120
  }
}
